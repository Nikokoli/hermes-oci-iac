# Copy to terraform.tfvars and fill in your OCI values.
# Never commit terraform.tfvals (it contains secrets) — it is gitignored.

tenancy_ocid   = "ocid1.tenancy.oc1..xxxx"
compartment_ocid = "ocid1.compartment.oc1..xxxx"
user_ocid        = "ocid1.user.oc1..xxxx"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "/home/ubuntu/.oci/api_key.pem"
region           = "us-ashburn-1"

availability_domain = "HukT:PHX-AD-1"
shape               = "VM.Standard2.1"
image_ocid          = "ocid1.image.oc1.phx.xxxxx"
